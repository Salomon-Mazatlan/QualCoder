   <item>
    <widget class="QWidget" name="widget_root" native="true">
     <property name="styleSheet">
      <string notr="true">
/* All rules are scoped to #widget_root so they win over plain type rules
   coming from a theme stylesheet. */

#widget_root QToolButton {
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 1px;
    background: transparent;
}
#widget_root QToolButton:hover { background: rgba(127, 127, 127, 0.20); }
#widget_root QToolButton:pressed { background: rgba(127, 127, 127, 0.34); }
#widget_root QToolButton:checked { background: rgba(127, 127, 127, 0.30); }
#widget_root QToolButton:focus { border: 1px solid rgba(46, 134, 222, 0.85); }

/* Themes that paint every widget would box the icon labels and the strips */
#widget_root QLabel { background: transparent; }
#widget_root QCheckBox { background: transparent; }
#widget_root QTabBar { background: transparent; }
#widget_root, #widget_mainWindow, #widget_left, #widget_textEdit, #groupBox_edit,
#groupBox_file_buttons, #groupBox_coding_buttons, #groupBox_2, #groupBox_info,
#tab_docs, #tab_ai { background: transparent; }

#widget_root QFrame[sep="true"] {
    background: transparent;
    border: none;
    border-left: 1px solid rgba(127, 127, 127, 0.45);
    margin: 3px 4px;
}

#widget_root QFrame#groupBox { background: rgba(127, 127, 127, 0.10); border-radius: 12px; }
#widget_root QFrame#groupBox_edit_mode { background: rgba(230, 150, 20, 0.16); border-radius: 12px; }

#widget_root QFrame#widget_coder,
#widget_root QFrame#searchBox,
#widget_root QFrame#codeFilterBox {
    border: 1px solid rgba(127, 127, 127, 0.40);
    border-radius: 15px;
    background: rgba(127, 127, 127, 0.07);
}
#widget_root QFrame#widget_coder QLineEdit,
#widget_root QFrame#searchBox QLineEdit,
#widget_root QFrame#codeFilterBox QLineEdit {
    border: none;
    background: transparent;
    padding: 0px;
}
#widget_root QLineEdit { border: 1px solid rgba(127, 127, 127, 0.40); border-radius: 8px; padding: 2px 8px; }
#widget_root QLineEdit:focus { border: 1px solid rgba(46, 134, 222, 0.85); }
#widget_root QComboBox { border: 1px solid rgba(127, 127, 127, 0.40); border-radius: 8px; padding: 2px 8px; }

#widget_root QListWidget,
#widget_root QTreeWidget,
#widget_root QTextEdit,
#widget_root QPlainTextEdit {
    border: 1px solid rgba(127, 127, 127, 0.30);
    border-radius: 8px;
}

#widget_root QTabWidget::pane { border: none; }
#widget_root QTabBar::tab { border: none; padding: 5px 12px; margin-right: 4px; border-radius: 8px; }
#widget_root QTabBar::tab:selected { background: rgba(127, 127, 127, 0.26); }
#widget_root QTabBar::tab:hover { background: rgba(127, 127, 127, 0.14); }

#widget_root QSplitter::handle { background: transparent; }

#widget_root QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 5px;
    border: 1px solid rgba(127, 127, 127, 0.65);
    background: transparent;
}
#widget_root QCheckBox::indicator:checked { background: rgba(46, 134, 222, 0.95); }

#widget_root QScrollBar:vertical { border: none; background: transparent; width: 10px; margin: 0px; }
#widget_root QScrollBar:horizontal { border: none; background: transparent; height: 10px; margin: 0px; }
#widget_root QScrollBar::handle:vertical, #widget_root QScrollBar::handle:horizontal {
    background: rgba(127, 127, 127, 0.45);
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
#widget_root QScrollBar::handle:vertical:hover, #widget_root QScrollBar::handle:horizontal:hover {
    background: rgba(127, 127, 127, 0.70);
}
#widget_root QScrollBar::add-line, #widget_root QScrollBar::sub-line { width: 0px; height: 0px; }
#widget_root QScrollBar::add-page, #widget_root QScrollBar::sub-page { background: transparent; }
</string>
